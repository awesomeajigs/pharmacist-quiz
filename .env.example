# Supabase project (Project Settings -> API). The publishable key is enough:
# the app only calls the submit_quiz_result / archetype_stats functions.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Public base URL used for share links and OpenGraph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
